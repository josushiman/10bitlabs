---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import AppGrid from '../components/AppGrid.astro';
import { listApps } from '../lib/apps';

const apps = await listApps();
---

<BaseLayout
  title="Apps — 10 Bit Labs"
  description="The apps 10 Bit Labs is designing and building, from active development through App Store submission."
>
  <section class="intro column">
    <SectionLabel spaceBelow={14}>apps</SectionLabel>
    <h1>Things we're building.</h1>
    <p>
      A short and growing list of the apps 10 Bit Labs designs and builds itself, moving
      from active development towards release.
    </p>
  </section>

  <section class="catalogue column">
    <AppGrid apps={apps} />
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 1100px;
    padding-block: 80px 40px;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    margin: 0 0 20px;
  }

  .intro p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--textDim);
    max-width: 56ch;
    margin: 0 0 20px;
  }

  .catalogue {
    max-width: 1100px;
    padding-block: 0 120px;
  }
</style>
