---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';

/*
  The design carries no 404, so this one is assembled from the vocabulary the
  rest of the site already speaks: a `//` label, a Space Grotesk heading, and a
  `./` command as the way out. Wrangler serves it for any unmatched path — see
  `not_found_handling` in wrangler.jsonc.
*/
---

<BaseLayout
  title="404 — 10 Bit Labs"
  description="That page could not be found. Head back to the 10 Bit Labs home page."
>
  <section class="page column">
    <SectionLabel>404</SectionLabel>
    <h1>No such page.</h1>
    <p>
      Whatever was here has moved, or the link that brought you was wrong. Nothing is
      broken — this address just doesn't lead anywhere.
    </p>
    <a class="home" href="/"><span aria-hidden="true">./</span>back-home <span aria-hidden="true">&rarr;</span></a>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 640px;
    padding-block: 120px 140px;
    text-align: center;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    margin: 14px 0 24px;
  }

  .page p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--textDim);
    margin: 0 0 40px;
  }

  .home {
    font-family: var(--font-mono);
    font-size: clamp(16px, 2.6vw, 20px);
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
  }

  .home:hover {
    opacity: 0.7;
  }
</style>
