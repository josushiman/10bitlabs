---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { COMPANY, MAILTO } from '../lib/company';
---

<BaseLayout
  title="Contact — 10 Bit Labs"
  description={`Reach 10 Bit Labs by email at ${COMPANY.email}. There is no contact form.`}
>
  <section class="page column">
    <SectionLabel>contact</SectionLabel>
    <h1>Get in touch.</h1>
    <p>
      There's no contact form — the easiest way to reach us is by email. We read
      everything and reply as soon as we can.
    </p>
    <a class="mail" href={MAILTO}><span aria-hidden="true">$ mail </span>{COMPANY.email}</a>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 640px;
    padding-block: 120px 140px;
    text-align: center;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    margin: 14px 0 24px;
  }

  .page p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--textDim);
    margin: 0 0 40px;
  }

  .mail {
    font-family: var(--font-mono);
    font-size: clamp(18px, 3.2vw, 24px);
    font-weight: 600;
    color: var(--accent);
    /*
      An inline-block so the address can wrap inside the element rather than
      overflowing a 320px phone, which a long mono string otherwise does.
    */
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .mail:hover {
    opacity: 0.7;
  }
</style>
