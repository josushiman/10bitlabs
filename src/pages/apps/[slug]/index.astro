---
import { render } from 'astro:content';
import AppMark from '../../../components/AppMark.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppFeatures from '../../../components/AppFeatures.astro';
import AppGallery from '../../../components/AppGallery.astro';
import AppPricing from '../../../components/AppPricing.astro';
import AppSupportSummary from '../../../components/AppSupportSummary.astro';
import Prose from '../../../components/Prose.astro';
import { screenshotsFor } from '../../../lib/app-screenshots';
import {
  hasDetail,
  listApps,
  listPrivacyPolicies,
  listSupportGuides,
  listTerms,
  statusLabelOf,
  type App,
  type AppSupport
} from '../../../lib/apps';
import { appStructuredData } from '../../../lib/structured-data';

/*
  The route materialises from the content: only an App with a body gets a path,
  so an App with nothing written about it has no detail page to reach, and the
  site's own 404 answers for it. Promoting an App to a page of its own is
  therefore writing that body — never plumbing.
*/
export async function getStaticPaths() {
  const apps = await listApps();
  const [policies, terms, support] = await Promise.all([
    listPrivacyPolicies(),
    listTerms(),
    listSupportGuides()
  ]);
  return apps.filter(hasDetail).map((app) => ({
    params: { slug: app.id },
    // Legal links exist only alongside the documents that publish their routes.
    props: {
      app,
      privacyPath: policies.has(app.id) ? `/apps/${app.id}/privacy/` : undefined,
      termsPath: terms.has(app.id) ? `/apps/${app.id}/terms/` : undefined,
      support: support.get(app.id),
      supportPath: support.has(app.id) ? `/apps/${app.id}/support/` : undefined
    }
  }));
}

interface Props {
  app: App;
  privacyPath?: string;
  termsPath?: string;
  support?: AppSupport;
  supportPath?: string;
}

const { app, privacyPath, termsPath, support, supportPath } = Astro.props;
const { name, icon, initials, description, platform, status, url, lang } = app.data;
const { Content } = await render(app);
const canonical = new URL(Astro.url.pathname, Astro.site);
const statusLabel = statusLabelOf(app);
const screenshots = screenshotsFor(app.id);
---

<BaseLayout
  title={`${name} — 10 Bit Labs`}
  description={description}
  structuredData={appStructuredData(app, canonical, Astro.site!)}
>
  <article class="page column">
    <a class="back" href="/apps/">All apps</a>

    <header class="hero">
      <AppMark class="app-mark" icon={icon} initials={initials} width={116} height={116} />
      <div class="hero-copy">
        {/* The other half of the card's shared heading — see AppCard.astro. */}
        <h1 lang={lang} data-app-title={app.id}>{name}</h1>
        <p class="standfirst">{description}</p>

        <div class="facts">
          <span class="platform" data-platform>{platform}</span>
          {statusLabel && <span class="tag">{statusLabel}</span>}
        </div>
      </div>
    </header>

    <section class="story" aria-label={`About ${name}`}>
      <Prose>
        <Content />
      </Prose>
    </section>

    {app.data.features && <AppFeatures appName={name} features={app.data.features} />}

    <AppGallery appName={name} screenshots={screenshots} />

    {
      app.data.purchase && (
        <AppPricing
          purchase={app.data.purchase}
          privacyPath={privacyPath}
          termsPath={termsPath}
        />
      )
    }

    {
      support && supportPath && (
        <AppSupportSummary
          appName={name}
          email={support.data.email}
          responseTime={support.data.responseTime}
          summary={support.data.summary}
          supportPath={supportPath}
        />
      )
    }

    <nav class="onward" aria-label={`${name} links`}>
      {
        /* A live App's store listing, and only a live one: the same rule the card
           applies to itself, so a page cannot offer a link the catalogue would not. */
        status === 'live' && url && (
          <a class="command" href={url} target="_blank" rel="noopener">
            <span aria-hidden="true">$ </span>open {name}
          </a>
        )
      }
      {
        !app.data.purchase && privacyPath && (
          <a class="command" href={privacyPath}>
            <span aria-hidden="true">$ </span>read the privacy policy
          </a>
        )
      }
      {
        !app.data.purchase && termsPath && (
          <a class="command" href={termsPath}>
            <span aria-hidden="true">$ </span>read the terms of service
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: 980px;
    padding-block: 80px 100px;
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--textDim);
    margin-bottom: 48px;
  }

  .back:hover {
    color: var(--accent);
  }

  .hero {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    align-items: start;
    gap: clamp(26px, 5vw, 54px);
    padding-bottom: 54px;
    margin-bottom: 54px;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 52%, transparent);
  }

  :global(.app-mark) {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 16px;
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-wash);
    border: 1px solid var(--accent-edge);
  }

  :global(.app-mark.has-icon) {
    background: none;
    border: 0;
  }

  h1 {
    font-size: clamp(2.7rem, 7vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0 0 24px;
  }

  .standfirst {
    font-size: 17px;
    line-height: 1.6;
    color: var(--textDim);
    max-width: 58ch;
    margin: 0 0 24px;
  }

  /*
    The card's own foot, restated at page scale: the same two labels a visitor
    just read on the catalogue, so arriving here is continuous with leaving there.
  */
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .platform,
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .platform {
    color: var(--textDim);
  }

  /* The card's tag, restated: same tokens, same readable label colour. */
  .tag {
    padding: 4px 8px;
    border-radius: 14px;
    color: var(--text);
    background: var(--accent-wash);
    border: 1px solid var(--accent-edge);
  }

  .story {
    max-width: 720px;
  }

  /* Empty when an App has neither a listing nor a legal document. */
  .onward {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    padding-top: 26px;
    border-top: 1px solid color-mix(in srgb, var(--border) 52%, transparent);
  }

  .onward:not(:empty) {
    margin-top: 72px;
  }

  .onward:empty {
    display: none;
  }

  .command {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
  }

  .command:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .page {
      padding-block: 56px 88px;
    }

    .back {
      margin-bottom: 36px;
    }

    .hero {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 20px;
      padding-bottom: 42px;
      margin-bottom: 42px;
    }

    :global(.app-mark) {
      border-radius: 14px;
      font-size: 15px;
    }

    h1 {
      font-size: clamp(2.5rem, 15vw, 4rem);
      margin-bottom: 18px;
    }

    .standfirst {
      font-size: 16px;
    }
  }
</style>
