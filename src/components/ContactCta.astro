---
import { COMPANY, MAILTO } from '../lib/company';

/*
  The closing band. Full-bleed rather than a column — the top border runs the
  whole width of the page, which is what separates it from the sections above.
*/
---

<section class="contact" data-contact>
  <h2>Have an idea or want to get in touch?</h2>
  <a class="mail" href={MAILTO}
    ><span aria-hidden="true">$ mail </span>{COMPANY.email}<span
      class="cursor"
      aria-hidden="true">▌</span
    ></a
  >
</section>

<style>
  .contact {
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    padding: 90px 28px;
    text-align: center;
  }

  h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 600;
    margin: 0 auto 20px;
    max-width: 20ch;
  }

  .mail {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--accent);
    /*
      An inline-block so the address wraps inside the element rather than
      overflowing a 320px phone, which a long mono string otherwise does.
    */
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .mail:hover {
    opacity: 0.7;
  }
</style>
