---
// The home page hero: the terminal window, the headline and the sub-paragraph.
---

<section class="hero">
  <div class="label"><span aria-hidden="true">// </span>uk software studio</div>

  <div class="terminal">
    <div class="titlebar">
      <span class="dot dot-red" aria-hidden="true"></span>
      <span class="dot dot-amber" aria-hidden="true"></span>
      <span class="dot dot-green" aria-hidden="true"></span>
      <span class="titletext">10bitlabs — zsh</span>
    </div>

    <div class="body">
      <div class="prompt" aria-hidden="true">$ whoami<span class="cursor">▌</span></div>

      <h1>We build useful apps for interesting problems.</h1>

      <p>
        10 Bit Labs designs, builds and publishes software products and apps — small,
        focused tools made to be genuinely useful.
      </p>

      <a class="cta" href="/apps">./explore-apps →</a>
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 100px 28px 90px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--textDim);
    margin-bottom: 18px;
  }

  .terminal {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg2);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  /*
    Hardcoded hex on purpose: these imitate the macOS window controls and stay
    the same in both palettes.
  */
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-red {
    background: #ff5f56;
  }

  .dot-amber {
    background: #ffbd2e;
  }

  .dot-green {
    background: #27c93f;
  }

  .titletext {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--textDim);
  }

  .body {
    padding: 40px 32px 46px;
  }

  .prompt {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    margin-bottom: 24px;
  }

  /*
    An unbounded blink is a WCAG 2.2.2 problem, so the effect only exists for
    visitors who have not asked their OS for less motion.
  */
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1s step-end infinite;
    }
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5.6vw, 4rem);
    line-height: 1.08;
    font-weight: 600;
    margin: 0 0 26px;
    max-width: 15ch;
    letter-spacing: -0.01em;
  }

  p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--textDim);
    max-width: 52ch;
    margin: 0 0 36px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    background: var(--accent);
    color: var(--accentText);
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    font-family: var(--font-mono);
  }

  .cta:hover {
    filter: brightness(1.08);
  }
</style>
