---
import AppMark from './AppMark.astro';
import { linkOf, statusLabelOf, type App } from '../lib/apps';

interface Props {
  app: App;
  /*
    One below the heading that opens the section the card sits in: the catalogue
    puts these under its `h1`, the home page's featured section under its `h2`.
  */
  headingLevel?: 2 | 3;
}

const { app, headingLevel = 2 } = Astro.props;
const HeadingTag = `h${headingLevel}` as const;
const { name, icon, initials, description, platform, lang } = app.data;

const link = linkOf(app);
const statusLabel = statusLabelOf(app);
// An App with nowhere real to send anyone is not a link. That is the whole
// difference between this card and the design's, which assumes every App shipped.
const Card = link ? 'a' : 'div';
---

<Card
  data-card
  class:list={['card', { linked: !!link }]}
  {...link ? { href: link.href } : {}}
  {...link?.external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <AppMark class="badge" icon={icon} initials={initials} width={56} height={56} />

  <div>
    {/*
      `data-app-title` is how a navigation finds the two headings that name the
      same App — this one and its detail page's — so it can animate the one into
      the other. See src/components/PageTransitions.astro.
    */}
    <HeadingTag class="name" lang={lang} data-app-title={app.id}>{name}</HeadingTag>
    <p class="description" data-description>{description}</p>
  </div>

  <div class="foot">
    <span class="platform" data-platform>{platform}</span>
    {statusLabel && <span class="tag">{statusLabel}</span>}
  </div>
</Card>

<style>
  /*
    The badge tile, the lifecycle tag and the detail page's restatement of
    both are one wash, one edge and one label type — named once in global.css so
    they cannot drift apart.
  */
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    border-radius: 16px;
    background: var(--bg2);
  }

  /* Only a card that goes somewhere reacts to being pointed at. */
  .linked {
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .linked:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .linked {
      transition: none;
    }

    .linked:hover {
      transform: none;
    }
  }

  :global(.badge) {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    color: var(--accent);
    background: var(--accent-wash);
    border: 1px solid var(--accent-edge);
    box-sizing: border-box;
  }

  .name {
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .description {
    font-size: 14px;
    line-height: 1.5;
    color: var(--textDim);
    margin: 0;
  }

  /*
    `margin-top:auto` is what keeps the platform labels on one baseline across a
    row of cards whose descriptions run to different lengths.
  */
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .platform {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: var(--label-tracking);
    color: var(--textDim);
  }

  /*
    Invented — the design has no lifecycle state. Built from what the card
    already says rather than a new vocabulary: the platform label's type at the
    badge tile's exact accent treatment.
  */
  .tag {
    font-family: var(--font-mono);
    font-size: var(--label-size);
    letter-spacing: var(--label-tracking);
    padding: 4px 8px;
    /* The badge tile's radius, so the card carries two corner radii and not three. */
    border-radius: 14px;
    /*
      The label is the site's text colour, not the accent: accent type on the
      accent's own wash measures 3.9:1 in Paper, under the 4.5:1 this site holds
      itself to. The wash and the edge still carry the accent — the badge tile's
      own initials keep the accent type because they are decorative, and this
      label is not.
    */
    color: var(--text);
    background: var(--accent-wash);
    border: 1px solid var(--accent-edge);
  }
</style>
