---
import MenuOverlay from './MenuOverlay.astro';
// Sticky header chrome, and the control that opens the site's navigation.
//
// The overlay is rendered as the header's sibling rather than inside it: the
// header is a stacking context of its own, and an overlay nested in it could
// never reliably sit above everything else on the page.
---

<header class="header">
  <a class="brand" href="/" aria-label="10 Bit Labs, home">
    <span class="mark" aria-hidden="true">
      <span class="bar bar-filled"></span>
      <span class="bar bar-outlined"></span>
    </span>
    <span class="wordmark">10 Bit Labs</span>
  </a>

  <div class="actions">
    <button
      id="theme-toggle"
      type="button"
      class="toggle"
      aria-label="Toggle dark/light mode"
      aria-pressed="false"
    >
      <span class="knob" aria-hidden="true"></span>
    </button>

    <button
      type="button"
      class="menu-button"
      data-menu-button
      aria-label="Menu"
      aria-controls="site-menu"
      aria-expanded="false"
    >
      {/* Two bars, not three — the design's own mark, and decoration only. */}
      <span class="menu-bar" aria-hidden="true"></span>
      <span class="menu-bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<MenuOverlay />

<script>
  /*
    The blocking script in <head> has already resolved the theme; this only
    handles an explicit change and persists it.

    Bound on `astro:page-load` rather than once, because navigation swaps the
    document rather than reloading it: this script is not re-run, but the button
    it was listening to has been replaced. Bound immediately as well, so the
    control still works if the router never arrives — and deduplicated by the
    element itself, so the two never stack up on the same button.
  */
  const root = document.documentElement;
  const bound = new WeakSet<Element>();

  const label = (theme: string) =>
    theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';

  const sync = (toggle: HTMLElement) => {
    const theme = root.dataset.theme ?? 'dark';
    toggle.setAttribute('title', label(theme));
    toggle.setAttribute('aria-pressed', String(theme === 'light'));
  };

  const bind = () => {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;

    if (!bound.has(toggle)) {
      bound.add(toggle);
      toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {
          // Private browsing or storage disabled: the choice just does not persist.
        }
        sync(toggle);
      });
    }

    // Every page is served with the same starting markup, so the control has to
    // be told again which palette it is actually sitting in.
    sync(toggle);
  };

  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 28px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* The same motif as the app icon: a filled "1" and an outlined "0". */
  .mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--bg2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .bar {
    width: 6px;
    height: 14px;
    border-radius: 1.5px;
  }

  .bar-filled {
    background: var(--accent);
  }

  .bar-outlined {
    border: 1.5px solid var(--accent);
    box-sizing: border-box;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.01em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .toggle {
    width: 44px;
    height: 24px;
    border-radius: 999px;
    background: var(--bg2);
    border: 1px solid var(--border);
    position: relative;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  /*
    Crimson parks the knob left, Paper parks it right — the design's only piece of
    state the palette drives that is not a colour. It stays here with the knob
    rather than becoming a global token: nothing else on the site has an opinion
    about where this one element sits.
  */
  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    transition: left 0.2s ease;
  }

  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme='dark'])) .knob {
      left: 22px;
    }
  }

  :global(html[data-theme='light']) .knob {
    left: 22px;
  }

  .menu-button {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .menu-bar {
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
</style>
