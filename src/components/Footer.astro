---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div><span aria-hidden="true">// </span>© {year} 10 Bit Labs Ltd</div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    width: 100%;
    box-sizing: border-box;
  }

  .inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--textDim);
  }
</style>
