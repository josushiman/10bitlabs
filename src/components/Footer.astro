---
import { COMPANY, MAILTO } from '../lib/company';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div><span aria-hidden="true">// </span>© {year} {COMPANY.name}</div>

    {/*
      Privacy and the company disclosure live here rather than in the menu, as
      the design has them: they are the two pages a visitor looks for at the
      bottom of a site, not ones they navigate to.
    */}
    <nav class="links" aria-label="Legal">
      <a href="/privacy/">Privacy</a>
      <a href="/legal/">Company details</a>
      <a href={MAILTO}>{COMPANY.email}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
    width: 100%;
    box-sizing: border-box;
  }

  .inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--textDim);
  }

  .links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .links a:hover {
    color: var(--text);
  }
</style>
