---
import { Image } from 'astro:assets';
import type { AppScreenshot } from '../lib/app-screenshots';

interface Props {
  appName: string;
  screenshots: AppScreenshot[];
}

const { appName, screenshots } = Astro.props;
---

{
  screenshots.length > 0 && (
    <section class="gallery" aria-labelledby="gallery-title" data-app-gallery>
      <div class="gallery-heading">
        <h2 id="gallery-title">A look inside</h2>
        <p>{screenshots.length} {screenshots.length === 1 ? 'screen' : 'screens'}</p>
      </div>

      <ul>
        {screenshots.map((screenshot) => (
          <li>
            <figure>
              <div class="screen">
                <Image
                  src={screenshot.image}
                  alt={`${appName} app screen: ${screenshot.label}`}
                  loading="lazy"
                />
              </div>
              <figcaption>{screenshot.label}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .gallery {
    margin-top: 72px;
  }

  .gallery-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
  }

  h2 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    margin: 0;
  }

  .gallery-heading p,
  figcaption {
    font-family: var(--font-mono);
    color: var(--textDim);
  }

  .gallery-heading p {
    font-size: var(--label-size);
    letter-spacing: var(--label-tracking);
    margin: 0;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  figure {
    margin: 0;
  }

  .screen {
    overflow: hidden;
    border-radius: 16px;
    background: var(--bg2);
    box-shadow: 0 16px 38px color-mix(in srgb, var(--text) 10%, transparent);
  }

  .screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    font-size: 12px;
    line-height: 1.5;
    margin-top: 10px;
  }

  @media (max-width: 620px) {
    ul {
      grid-auto-flow: column;
      grid-auto-columns: min(76vw, 280px);
      grid-template-columns: none;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-color: var(--border) transparent;
      padding: 0 28px 18px;
      margin-inline: -28px;
    }

    li {
      scroll-snap-align: start;
    }
  }
</style>
