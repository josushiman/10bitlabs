---
import { Image } from 'astro:assets';
import type { AppScreenshot } from '../lib/app-screenshots';

interface Props {
  appName: string;
  screenshots: AppScreenshot[];
}

const { appName, screenshots } = Astro.props;
---

{
  screenshots.length > 0 && (
    <section class="gallery" aria-labelledby="gallery-title" data-app-gallery>
      <div class="gallery-heading">
        <h2 id="gallery-title">A look inside</h2>
        {
          screenshots.length > 1 ? (
            <div class="gallery-controls" aria-label="Screenshot controls" data-gallery-controls>
              <button type="button" aria-label="Show previous screen" data-gallery-previous disabled>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m9.5 3-5 5 5 5" />
                </svg>
              </button>
              <p role="status" aria-live="polite" aria-atomic="true" data-gallery-position>
                1 / {screenshots.length}
              </p>
              <button type="button" aria-label="Show next screen" data-gallery-next>
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m6.5 3 5 5-5 5" />
                </svg>
              </button>
            </div>
          ) : (
            <p>1 screen</p>
          )
        }
      </div>

      <div class="gallery-viewport" data-gallery-viewport>
        <ul>
          {screenshots.map((screenshot, index) => (
            <li data-gallery-slide>
              <figure>
                <div class="screen">
                  <Image
                    src={screenshot.image}
                    alt={`${appName} app screen: ${screenshot.label}`}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                <figcaption>{screenshot.label}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  /*
    The gallery deliberately lets the browser do the sliding. A scroll-snap
    track keeps touch, trackpad and button navigation in agreement, without a
    duplicated JavaScript idea of where the screen is.
  */
  const boundGalleries = new WeakSet<HTMLElement>();

  const bindGallery = (gallery: HTMLElement) => {
    if (boundGalleries.has(gallery)) return;

    const viewport = gallery.querySelector<HTMLElement>('[data-gallery-viewport]');
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const position = gallery.querySelector<HTMLElement>('[data-gallery-position]');

    if (!viewport || !previous || !next || !position || slides.length < 2) return;
    boundGalleries.add(gallery);

    const currentSlide = () => {
      let current = 0;
      let closest = Number.POSITIVE_INFINITY;

      slides.forEach((slide, index) => {
        const distance = Math.abs(slide.offsetLeft - viewport.scrollLeft);
        if (distance < closest) {
          current = index;
          closest = distance;
        }
      });

      return current;
    };

    const update = () => {
      const current = currentSlide();
      position.textContent = `${current + 1} / ${slides.length}`;
      previous.disabled = current === 0;
      next.disabled = current === slides.length - 1;
    };

    const show = (index: number) => {
      const target = slides[index];
      if (!target) return;
      viewport.scrollTo({ left: target.offsetLeft });
    };

    previous.addEventListener('click', () => show(currentSlide() - 1));
    next.addEventListener('click', () => show(currentSlide() + 1));
    viewport.addEventListener('scroll', update, { passive: true });
    update();
  };

  const bindGalleries = () =>
    document.querySelectorAll<HTMLElement>('[data-app-gallery]').forEach(bindGallery);

  bindGalleries();
  document.addEventListener('astro:page-load', bindGalleries);
</script>

<style>
  .gallery {
    margin-top: 72px;
  }

  .gallery-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
  }

  h2 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    font-weight: 600;
    margin: 0;
  }

  .gallery-heading p,
  figcaption {
    font-family: var(--font-mono);
    color: var(--textDim);
  }

  .gallery-heading p {
    font-size: var(--label-size);
    letter-spacing: var(--label-tracking);
    margin: 0;
  }

  .gallery-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gallery-controls p {
    min-width: 3.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  button {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text);
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  button:hover:not(:disabled) {
    color: var(--accentText);
    background: var(--accent);
    border-color: var(--accent);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }

  button svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .gallery-viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    background: var(--bg2);
    border: 1px solid color-mix(in srgb, var(--border) 64%, transparent);
  }

  .gallery-viewport::-webkit-scrollbar {
    display: none;
  }

  ul {
    display: grid;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  figure {
    display: grid;
    justify-items: center;
    margin: 0;
    padding: clamp(28px, 6vw, 56px) 28px 24px;
  }

  .screen {
    width: min(100%, 336px);
    overflow: hidden;
    border-radius: 16px;
    background: var(--bg2);
    box-shadow: 0 16px 38px color-mix(in srgb, var(--text) 10%, transparent);
  }

  .screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    width: min(100%, 336px);
    font-size: 12px;
    line-height: 1.5;
    margin-top: 10px;
  }

  li {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-viewport {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 480px) {
    .gallery-heading {
      align-items: center;
    }

    figure {
      padding-inline: 20px;
    }
  }
</style>
