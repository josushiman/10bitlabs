---
interface Props {
  appName: string;
  email: string;
  responseTime: string;
  summary: string;
  supportPath: string;
}

const { appName, email, responseTime, summary, supportPath } = Astro.props;
---

<section class="support" aria-labelledby="support-title" data-app-support>
  <h2 id="support-title">Need help?</h2>
  <div>
    <p>{summary} We aim to reply {responseTime}.</p>
    <nav aria-label={`${appName} support options`}>
      <a href={`${supportPath}#refund-and-billing-help`}>Request a refund</a>
      <a href={`${supportPath}#restore-a-purchase`}>Restore a purchase</a>
      <a href={`${supportPath}#report-a-problem`}>Report a problem</a>
      <a href={`mailto:${email}`}>Contact support</a>
    </nav>
  </div>
</section>

<style>
  .support {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 34px;
    padding-top: 32px;
    margin-top: 80px;
    border-top: 1px solid color-mix(in srgb, var(--border) 64%, transparent);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    color: var(--textDim);
    line-height: 1.65;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
  }

  a {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 620px) {
    .support {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 64px;
    }
  }
</style>
