---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiraAppIcon from './SiraAppIcon.astro';

interface Props {
  icon?: ImageMetadata | 'sira';
  initials: string;
  width: number;
  height: number;
  class?: string;
}

const { icon, initials, width, height, class: className } = Astro.props;
---

<div class:list={['app-mark', className, { 'has-icon': !!icon }]} data-badge aria-hidden="true">
  {
    icon === 'sira' ? (
      <SiraAppIcon size={width} />
    ) : icon ? (
      <Image src={icon} alt="" {width} {height} />
    ) : (
      initials
    )
  }
</div>

<style>
  .app-mark {
    overflow: hidden;
  }

  .app-mark.has-icon {
    container-type: inline-size;
    overflow: visible;
  }

  .app-mark :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
