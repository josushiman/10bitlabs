---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon?: ImageMetadata;
  initials: string;
  width: number;
  height: number;
  class?: string;
}

const { icon, initials, width, height, class: className } = Astro.props;
---

<div class:list={['app-mark', className]} data-badge aria-hidden="true">
  {icon ? <Image src={icon} alt="" {width} {height} /> : initials}
</div>

<style>
  .app-mark {
    overflow: hidden;
  }

  .app-mark :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
