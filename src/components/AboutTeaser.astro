---
import SplitSection from './SplitSection.astro';
import RouteLink from './RouteLink.astro';

/*
  The one sentence on the site that saves both sides an email: the Studio builds
  and publishes its own apps and is not available for hire. It is stated here in
  the design's own words, less "products" — a term `CONTEXT.md` avoids for an App.
*/
---

<SplitSection label="about" data-about-teaser>
  <p>
    10 Bit Labs is a small UK software studio. We design, build and publish our own
    apps rather than working for hire — favouring the kind of thing we'd want to use
    ourselves.
  </p>
  <RouteLink href="/about/">./more-about-us →</RouteLink>
</SplitSection>

<style>
  p {
    margin: 0 0 20px;
  }
</style>
